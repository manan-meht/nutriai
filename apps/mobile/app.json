{
  "expo": {
    "name": "Tistra Health",
    "slug": "tistra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tistramobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.tistrahealth.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Tistra Health uses your camera so you can photograph a meal and get its nutrition estimate.",
        "NSPhotoLibraryUsageDescription": "Tistra Health needs access to your photos so you can choose a meal picture you have already taken.",
        "NSPhotoLibraryAddUsageDescription": "Tistra Health saves a meal photo back to your library when you ask it to.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.tistrahealth.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5715CE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "./plugins/withConsistentKotlinJvmTarget",
      [
        "./plugins/withAdaptiveDynamicIcons",
        {
          "bowl_empty": {
            "image": "./assets/images/dynamic-icon/bowl-empty.png"
          },
          "bowl_quarter": {
            "image": "./assets/images/dynamic-icon/bowl-quarter.png"
          },
          "bowl_half": {
            "image": "./assets/images/dynamic-icon/bowl-half.png"
          },
          "bowl_full": {
            "image": "./assets/images/dynamic-icon/bowl-full.png"
          }
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "bowl_empty": {
            "image": "./assets/images/dynamic-icon/bowl-empty.png"
          },
          "bowl_quarter": {
            "image": "./assets/images/dynamic-icon/bowl-quarter.png"
          },
          "bowl_half": {
            "image": "./assets/images/dynamic-icon/bowl-half.png"
          },
          "bowl_full": {
            "image": "./assets/images/dynamic-icon/bowl-full.png"
          }
        }
      ],
      "./plugins/withAndroidFreeOrientation",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# expo-notifications ships this rule in its own proguard-rules.pro but never\n# declares consumerProguardFiles, so R8 would not apply it. Its notification\n# content and trigger types are deserialised reflectively, and a stripped one\n# fails at delivery time rather than at build time.\n-keep class expo.modules.notifications.** { *; }\n\n# RevenueCat. A purchase is the one path where a silent R8 failure costs money\n# rather than a screen, so these are kept explicitly rather than trusted to the\n# AAR's own consumer rules.\n-keep class com.revenuecat.purchases.** { *; }\n-keep class com.android.billingclient.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbcef5e6-8fc6-433a-86b6-db5ab2c430c0"
      }
    },
    "owner": "mandarth"
  }
}
