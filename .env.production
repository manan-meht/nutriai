# Build-time public configuration for production.
#
# NEXT_PUBLIC_* values are INLINED BY NEXT.JS AT BUILD TIME. Runtime
# secrets (wrangler secret put) are therefore useless for them: the
# client bundle is already compiled by the time the worker starts.
#
# This caused a production outage on 18 Aug 2026 — Workers Builds CI had
# none of these set, so createBrowserClient() received undefined and threw
# "Your project's URL and API key are required" during hydration on EVERY
# page using the browser Supabase client (all web logins, all products).
# The server rendered fine, which is why every server-side check passed.
#
# Everything here is public by definition: it ships inside the JavaScript
# bundle served to every visitor. The Supabase anon key is designed for
# this and is protected by RLS. Nothing secret belongs in this file —
# secrets stay in wrangler secrets / .env.local (both gitignored).

NEXT_PUBLIC_SUPABASE_URL=https://tyjbpwtgidkouhwdiyfy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR5amJwd3RnaWRrb3Vod2RpeWZ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI4MjExOTYsImV4cCI6MjA5ODM5NzE5Nn0.kaYe-L5PXy_Cnx0KTer4tSWzX1PVecYq4QoVnzLsbSg
NEXT_PUBLIC_PRODUCT=gym
NEXT_PUBLIC_GYM_DOMAIN=coach.tistrahealth.com
NEXT_PUBLIC_FAMILY_DOMAIN=family.tistrahealth.com
NEXT_PUBLIC_END_USER_DASHBOARD_ENABLED=false
NEXT_PUBLIC_UNIFIED_HOME_ENABLED=true
NEXT_PUBLIC_FAMILY_LIMIT_ENFORCEMENT_ENABLED=true
NEXT_PUBLIC_GYM_LIMIT_ENFORCEMENT_ENABLED=true
NEXT_PUBLIC_BILLING_AVAILABLE=true
NEXT_PUBLIC_SUBSCRIPTION_ENFORCEMENT_ENABLED=true
NEXT_PUBLIC_FAMILY_TRIAL_ENFORCEMENT_ENABLED=true
NEXT_PUBLIC_GYM_TRIAL_ENFORCEMENT_ENABLED=true
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=true
NEXT_PUBLIC_INTL_USD_BILLING_ENABLED=true
NEXT_PUBLIC_RAZORPAY_ENABLED=false
NEXT_PUBLIC_PAYNOW_ENABLED=false
NEXT_PUBLIC_ACH_ENABLED=false
NEXT_PUBLIC_BECS_ENABLED=false
NEXT_PUBLIC_NEW_TISTRA_HOMEPAGE_ENABLED=true
NEXT_PUBLIC_SELF_TRACKING_ENABLED=true
NEXT_PUBLIC_FOOD_BALANCE_SCORE_V1=true
NEXT_PUBLIC_PARENT_DASHBOARD_ACCESS_ENABLED=true

# Tistra Club's own domain. /club/... on any non-club host redirects here,
# so Tistra Health stops serving a second copy of the marketplace.
NEXT_PUBLIC_CLUB_ORIGIN=https://tistra.club
